---
import Base from "../layouts/Base.astro";
import { FRIEND_GROUPS, MY_CARD } from "../data/friends";

const total = FRIEND_GROUPS.reduce((n, g) => n + g.friends.length, 0);
---

<Base title="友链">
  <div class="wrap">
    <header class="page-head">
      <h1>友链</h1>
      <p>朋友们的小站。</p>
    </header>

    {
      total === 0 ? (
        <p class="empty">这里还空着，欢迎来做第一个邻居。</p>
      ) : (
        FRIEND_GROUPS.filter((g) => g.friends.length).map((g) => (
          <section class="group">
            <h2 class="section-title">{g.title}</h2>
            <div class="grid">
              {g.friends.map((f) => (
                <a class="friend" href={f.href} rel="noopener">
                  {f.avatar ? (
                    <img src={f.avatar} alt="" width="44" height="44" loading="lazy" />
                  ) : (
                    <span class="ph mono">{f.name.slice(0, 1)}</span>
                  )}
                  <span class="meta">
                    <span class="name">{f.name}</span>
                    {f.description && <span class="desc">{f.description}</span>}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      )
    }

    <section class="exchange">
      <h2 class="section-title">交换友链</h2>
      <p class="muted">在 GitHub 上给我发 issue 或者直接联系我，带上下面这些信息就行：</p>
      <pre class="mono">{`name: ${MY_CARD.name}
link: ${MY_CARD.href}
desc: ${MY_CARD.description}
avatar: ${MY_CARD.avatar}`}</pre>
    </section>
  </div>
</Base>

<style>
  .group + .group {
    margin-top: 36px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .friend {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-raise);
    color: var(--fg);
  }
  .friend:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  img,
  .ph {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    flex: none;
    /* 头像按原图完整显示，不裁剪 */
    object-fit: contain;
  }
  .ph {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-weight: 500;
  }
  .desc {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .exchange {
    margin-top: 48px;
  }
  pre {
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--code-bg);
    font-size: 13px;
    overflow-x: auto;
  }
</style>
