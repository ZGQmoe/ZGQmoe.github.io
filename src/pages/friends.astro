---
import Base from "../layouts/Base.astro";
import { FRIEND_GROUPS, MY_CARD } from "../data/friends";
import { QUOTES } from "../data/quotes";

const total = FRIEND_GROUPS.reduce((n, g) => n + g.friends.length, 0);
---

<Base title="友链">
  <div class="wrap">
    <header class="page-head">
      <h1>友链</h1>
      <p>我的好朋友们。</p>
    </header>

    {
      total === 0 ? (
        <p class="empty">这里还空着，欢迎来做第一个邻居。</p>
      ) : (
        FRIEND_GROUPS.filter((g) => g.friends.length).map((g) => (
          <section class="group">
            <h2 class="section-title">{g.title}</h2>
            <div class="grid">
              {g.friends.map((f) => (
                <a class="friend" href={f.href} rel="noopener">
                  {f.avatar ? (
                    <img src={f.avatar} alt="" width="44" height="44" loading="lazy" />
                  ) : (
                    <span class="ph mono">{f.name.slice(0, 1)}</span>
                  )}
                  <span class="meta">
                    <span class="name">{f.name}</span>
                    {f.description && <span class="desc">{f.description}</span>}
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      )
    }

    <section class="exchange">
      <h2 class="section-title">交换友链</h2>
      <p class="muted">通过 GitHub：<a href="https://github.com/ZGQmoe">@ZGQmoe</a></p>
      <div class="card-box" data-quotes={JSON.stringify(QUOTES)}>
        <pre class="mono">name: {MY_CARD.name}
link: {MY_CARD.href}
desc: <span class="q">{QUOTES[0]}</span>
avatar: {MY_CARD.avatar}</pre>
        <button class="copy mono" type="button">复制</button>
      </div>
      <p class="hint muted">desc 是从我喜欢的句子里随机抽的，每次复制完都会换一句。</p>
    </section>
  </div>
</Base>

<script>
  function setupCard() {
    const box = document.querySelector<HTMLElement>(".card-box");
    if (!box || box.dataset.ready) return;
    box.dataset.ready = "1";
    const quotes: string[] = JSON.parse(box.dataset.quotes || "[]");
    const q = box.querySelector<HTMLElement>(".q")!;
    const pre = box.querySelector("pre")!;
    const btn = box.querySelector<HTMLButtonElement>(".copy")!;
    // 换一句，并且尽量不和当前这句重复
    const next = () => {
      if (quotes.length < 2) return;
      let s = q.textContent;
      while (s === q.textContent) s = quotes[Math.floor(Math.random() * quotes.length)];
      q.textContent = s;
    };
    next();
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = "已复制 ✓";
      } catch {
        btn.textContent = "复制失败";
      }
      setTimeout(() => {
        btn.textContent = "复制";
        next();
      }, 1200);
    });
  }
  document.addEventListener("astro:page-load", setupCard);
</script>

<style>
  .group + .group {
    margin-top: 36px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
  }
  .friend {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-raise);
    color: var(--fg);
  }
  .friend:hover {
    border-color: var(--accent);
    text-decoration: none;
  }
  img,
  .ph {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    flex: none;
    /* 头像按原图完整显示，不裁剪 */
    object-fit: contain;
  }
  .ph {
    display: grid;
    place-items: center;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
  .meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    font-weight: 500;
  }
  .desc {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .exchange {
    margin-top: 48px;
  }
  .card-box {
    position: relative;
  }
  .copy {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 4px 10px;
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-raise);
    color: var(--fg);
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .q {
    transition: opacity 0.2s;
  }
  .hint {
    font-size: 13px;
    margin-top: 8px;
  }
  pre {
    padding: 14px 72px 14px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--code-bg);
    font-size: 13px;
    overflow-x: auto;
  }
</style>
