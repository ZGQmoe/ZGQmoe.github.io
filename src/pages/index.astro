---
// 版式 A「纵向」：一屏鲨鱼 + 名片，往下依次是项目、笔记、最近更新。
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import SectionHead from "../components/home/SectionHead.astro";
import CourseChips from "../components/home/CourseChips.astro";
import PostList from "../components/PostList.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { homeData } from "../utils/home";

const { recent, courses, projects } = await homeData();
---

<Base ocean="full">
  <Hero />

  <div id="content" class="stack">
    <section>
      <SectionHead en="Projects" title="项目" more={{ href: "/projects/", label: "全部" }} />
      <div class="grid2">{projects.map((p, i) => <ProjectCard {...p} big={i === 0} />)}</div>
    </section>

    <section>
      <SectionHead en="Notes" title="专业笔记" more={{ href: "/notes/", label: "笔记" }} />
      <CourseChips courses={courses} />
    </section>

    <section>
      <SectionHead en="Latest" title="最近更新" more={{ href: "/archive/", label: "归档" }} />
      <div class="glass list reveal">
        <PostList posts={recent} />
      </div>
    </section>
  </div>
</Base>

<style>
  .stack {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 56px;
    scroll-margin-top: 72px;
  }
  .grid2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
  }
  .list {
    padding: 4px 20px;
  }
  .list :global(li:first-child) {
    border-top: 0;
  }
  .list :global(li:last-child) {
    border-bottom: 0;
  }
</style>
