---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { ALL_COURSES, getCourseNotes, splitTitle, unitsOf, type Course, type Note, type Unit } from "../../utils/notes";

export async function getStaticPaths() {
  const paths = [];
  for (const course of ALL_COURSES) {
    const notes = await getCourseNotes(course.slug);
    const units = unitsOf(notes);
    const readme = notes.find((n) => n.data.index);
    paths.push({ params: { slug: course.slug }, props: { course, units, note: readme, isLanding: true } });
    units.forEach((unit, i) =>
      unit.tabs.forEach((note) =>
        paths.push({
          params: { slug: note.id },
          props: { course, units, note, unit, isLanding: false, prev: units[i - 1], next: units[i + 1] },
        }),
      ),
    );
  }
  return paths;
}

interface Props {
  course: Course;
  units: Unit[];
  note?: Note;
  unit?: Unit;
  isLanding: boolean;
  prev?: Unit;
  next?: Unit;
}
const { course, units, note, unit, isLanding, prev, next } = Astro.props;
const rendered = note ? await render(note) : null;
const Content = rendered?.Content;
const toc = (rendered?.headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3);
const repoUrl = `https://github.com/${course.repo}`;
const ut = unit ? splitTitle(unit.title) : null;
const pageTitle = isLanding
  ? `${course.code} ${course.title}`
  : `${unit!.title}${note!.data.tab ? " · " + note!.data.tabLabel : ""} · ${course.code}`;
const unitHref = (u: Unit) => `/notes/${u.tabs[0].id}/`;
---

<Base title={pageTitle} progress={!isLanding}>
  <div class="notes-shell">
    <aside class="side">
      <details class="side-box" open>
        <summary class="mono">
          <span class="code">{course.code}</span>
          <span class="muted">· 目录</span>
        </summary>
        <nav class="side-nav">
          <a href={`/notes/${course.slug}/`} class:list={{ on: isLanding }}>课程首页</a>
          {
            units.map((u) => {
              const t = splitTitle(u.title);
              return (
                <a href={unitHref(u)} class:list={["unit", { on: unit?.key === u.key }]}>
                  <span class="u-head">{t.head}</span>
                  {t.sub && <span class="u-sub">{t.sub}</span>}
                  {u.tabs.length > 1 && <span class="u-tabs mono">{u.tabs.map((x) => x.data.tabLabel).join(" · ")}</span>}
                </a>
              );
            })
          }
        </nav>
        <a class="back mono" href="/notes/">← 所有课程</a>
      </details>
    </aside>

    <article class="doc wrap-doc">
      {
        isLanding ? (
          <header class="doc-head">
            <div class="crumb mono">
              <a href="/notes/">笔记</a> / {course.code}
            </div>
            <h1>
              <span class="grad-text">{course.code}</span> {course.title}
            </h1>
            <div class="links">
              <a class="chip" href={repoUrl}>
                <Icon name="github" size={13} /> 仓库
              </a>
              {course.extras?.map((x) => (
                <a class="chip" href={x.href}>
                  <Icon name="arrow" size={13} /> {x.label}
                </a>
              ))}
            </div>
          </header>
        ) : (
          <header class="doc-head">
            <div class="crumb mono">
              <a href="/notes/">笔记</a> / <a href={`/notes/${course.slug}/`}>{course.code}</a>
            </div>
            <h1>
              {ut!.sub ? (
                <>
                  <span class="grad-text">{ut!.head}</span> <span class="h-sub">{ut!.sub}</span>
                </>
              ) : (
                ut!.head
              )}
            </h1>
            {unit!.tabs.length > 1 && (
              <nav class="tabs" aria-label="本章内容">
                {unit!.tabs.map((t) => (
                  <a href={`/notes/${t.id}/`} class:list={{ on: t.id === note!.id }} aria-current={t.id === note!.id ? "page" : undefined}>
                    {t.data.tabLabel}
                  </a>
                ))}
              </nav>
            )}
            <a class="src mono" href={note!.data.source}>
              <Icon name="github" size={13} /> 源文件
            </a>
          </header>
        )
      }

      {
        isLanding && (
          <div class="chapters">
            <ol>
              {units.map((u, i) => {
                const t = splitTitle(u.title);
                return (
                  <li>
                    <a class="spot" href={unitHref(u)}>
                      <span class="n mono">{String(i + 1).padStart(2, "0")}</span>
                      <span class="t">
                        <b>{t.head}</b>
                        {t.sub && <span>{t.sub}</span>}
                      </span>
                      {u.tabs.length > 1 && <span class="k mono">{u.tabs.map((x) => x.data.tabLabel).join(" · ")}</span>}
                    </a>
                  </li>
                );
              })}
            </ol>
          </div>
        )
      }

      {
        Content && (
          <div class:list={["prose", { readme: isLanding }]}>
            <Content />
          </div>
        )
      }

      {
        !isLanding && (
          <nav class="pager">
            {prev ? (
              <a href={unitHref(prev)}>
                <span class="mono">← 上一章</span>
                {prev.title}
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="right" href={unitHref(next)}>
                <span class="mono">下一章 →</span>
                {next.title}
              </a>
            )}
          </nav>
        )
      }
    </article>

    <aside class="toc">
      {
        toc.length > 1 && (
          <div class="toc-box">
            <div class="toc-title mono">本页</div>
            {toc.map((h) => (
              <a href={`#${h.slug}`} class:list={[`d${h.depth}`]} data-toc={h.slug}>
                {h.text}
              </a>
            ))}
          </div>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .notes-shell {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px 20px 0;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 200px;
    gap: 24px;
    align-items: start;
  }
  .side,
  .toc {
    position: sticky;
    top: 76px;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
  }
  .side-box,
  .toc-box,
  .doc {
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .side-box {
    padding: 14px 12px;
  }
  summary {
    list-style: none;
    cursor: pointer;
    font-size: 13px;
    padding: 0 6px 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .code {
    font-weight: 600;
    color: var(--accent);
  }
  .side-nav {
    display: flex;
    flex-direction: column;
  }
  .side-nav a {
    font-size: 14px;
    line-height: 1.45;
    padding: 6px 8px;
    border-radius: 8px;
    color: var(--muted);
  }
  .side-nav a:hover {
    color: var(--fg);
    background: var(--accent-soft);
    text-decoration: none;
  }
  .side-nav a.on {
    color: var(--accent);
    background: var(--accent-soft);
    font-weight: 500;
  }
  .unit {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .u-head {
    color: var(--fg);
    font-weight: 500;
  }
  .unit.on .u-head {
    color: var(--accent);
  }
  .u-sub {
    font-size: 13px;
  }
  .u-tabs {
    font-size: 11px;
    opacity: 0.75;
  }
  .h-sub {
    font-weight: 600;
  }
  .tabs {
    display: flex;
    gap: 4px;
    margin: 4px 0 12px;
    padding: 4px;
    width: fit-content;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--bg) 50%, transparent);
  }
  .tabs a {
    padding: 6px 16px;
    border-radius: 9px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }
  .tabs a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .tabs a.on {
    color: #fff;
    background: linear-gradient(100deg, var(--grad-1), var(--grad-2));
  }
  .grp {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
  }
  .grp-name {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding: 8px 8px 2px;
    opacity: 0.8;
  }
  .back {
    display: block;
    font-size: 12px;
    padding: 12px 8px 0;
    margin-top: 8px;
    border-top: 1px solid var(--line);
  }
  .doc {
    padding: 8px 36px 36px;
  }
  .doc-head {
    padding: 28px 0 18px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
  }
  .crumb {
    font-size: 12px;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(24px, 3.4vw, 30px);
    margin: 6px 0 10px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
  }
  .src {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
  }
  .chapters ol {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    gap: 8px;
  }
  .chapters a {
    display: grid !important;
    grid-template-columns: 32px 1fr auto;
    align-items: center;
    gap: 12px;
  }
  .chapters .n {
    color: var(--muted);
    font-size: 12px;
  }
  .chapters .t {
    display: flex;
    flex-direction: column;
  }
  .chapters .t span {
    font-size: 13px;
    color: var(--muted);
  }
  .chapters .k {
    font-size: 11px;
    color: var(--accent);
  }
  .chapters section + section {
    margin-top: 12px;
  }
  .chapters a {
    display: block;
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg-raise);
    color: var(--fg);
    font-size: 14px;
  }
  .chapters a:hover {
    text-decoration: none;
  }
  .readme {
    border-top: 1px dashed var(--line);
    padding-top: 8px;
  }
  .toc-box {
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
  }
  .toc-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    padding: 0 6px 8px;
  }
  .toc a {
    font-size: 13px;
    line-height: 1.4;
    padding: 4px 6px;
    color: var(--muted);
    border-left: 2px solid transparent;
  }
  .toc a.d3 {
    padding-left: 18px;
    font-size: 12px;
  }
  .toc a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  .toc a.on {
    color: var(--accent);
    border-left-color: var(--accent);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    color: var(--fg);
  }
  .pager a span {
    font-size: 12px;
    color: var(--muted);
  }
  .pager .right {
    text-align: right;
  }
  @media (max-width: 1180px) {
    .notes-shell {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .notes-shell {
      grid-template-columns: 1fr;
      padding: 12px 10px 0;
      gap: 12px;
    }
    .side {
      position: static;
      max-height: none;
    }
    .doc {
      padding: 4px 18px 28px;
    }
  }
</style>

<script>
  import { initNotesPage } from "../../scripts/notes";
  document.addEventListener("astro:page-load", initNotesPage);
</script>
