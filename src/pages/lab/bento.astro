---
// 版式 B「Bento 网格」：半屏名片，下面是一整块拼图式网格。
import Base from "../../layouts/Base.astro";
import Hero from "../../components/home/Hero.astro";
import Icon from "../../components/Icon.astro";
import { formatDate } from "../../utils/posts";
import { homeData } from "../../utils/home";
import { SITE } from "../../config";

const { recent, courses, projects, stats } = await homeData();
const [main, ...rest] = projects;
---

<Base ocean="full" title="版式 B · Bento">
  <Hero tall={false} />

  <div id="content" class="bento">
    <a class="tile t-proj spot reveal" href={main.live || main.repo}>
      <span class="label mono">{main.kind} · 维护中</span>
      <span class="big mono">{main.name}</span>
      <p>{main.description}</p>
      <span class="go mono">打开 <Icon name="arrow" size={14} /></span>
    </a>

    <div class="tile t-stats reveal">
      <span class="label mono">Stats</span>
      <div class="nums">
        <div><b class="grad-text mono">{stats.notes}</b><span>篇笔记</span></div>
        <div><b class="grad-text mono">{stats.posts}</b><span>篇文章</span></div>
        <div><b class="grad-text mono">{stats.days}</b><span>天</span></div>
      </div>
    </div>

    <a class="tile t-about spot reveal" href="/about/">
      <span class="label mono">About</span>
      <p>{SITE.bio}</p>
      <span class="go mono">关于我 <Icon name="arrow" size={14} /></span>
    </a>

    <div class="tile t-notes reveal">
      <span class="label mono">Notes · 专业笔记</span>
      <div class="courses">
        {
          courses.map((c) => (
            <a href={`/notes/${c.slug}/`}>
              <span class="mono code">{c.code}</span>
              <span>{c.title}</span>
              <span class="mono n">{c.count}</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="tile t-posts reveal">
      <span class="label mono">Latest · 最近更新</span>
      <ul>
        {
          recent.map((p) => (
            <li>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
              <time class="mono">{formatDate(p.data.date)}</time>
            </li>
          ))
        }
      </ul>
      <a class="go mono" href="/archive/">归档 <Icon name="arrow" size={14} /></a>
    </div>

    {
      rest.map((p) => (
        <a class="tile t-small spot reveal" href={p.live || p.repo}>
          <span class="label mono">{p.kind}</span>
          <span class="mid mono">{p.name}</span>
          <span class="go mono">
            打开 <Icon name="arrow" size={14} />
          </span>
        </a>
      ))
    }

    <a class="tile t-small spot reveal" href="/friends/">
      <span class="label mono">Friends</span>
      <span class="mid">友链 {stats.friends > 0 ? stats.friends : ""}</span>
      <span class="go mono">串门 <Icon name="arrow" size={14} /></span>
    </a>
  </div>
</Base>

<style>
  .bento {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(130px, auto);
    gap: 14px;
    scroll-margin-top: 72px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    color: var(--fg);
    transition: transform 0.2s;
  }
  a.tile:hover {
    text-decoration: none;
    transform: translateY(-3px);
  }
  .label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .big {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 600;
    line-height: 1.15;
  }
  .mid {
    font-size: 18px;
    font-weight: 600;
    flex: 1;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
    flex: 1;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--accent);
    margin-top: auto;
  }
  .t-proj {
    grid-column: span 2;
    grid-row: span 2;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--grad-2) 22%, transparent), transparent 60%),
      var(--glass);
  }
  .t-stats {
    grid-column: span 2;
  }
  .nums {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-top: auto;
  }
  .nums div {
    display: flex;
    flex-direction: column;
  }
  .nums b {
    font-size: 32px;
    line-height: 1.1;
  }
  .nums span {
    font-size: 12px;
    color: var(--muted);
  }
  .t-about {
    grid-column: span 2;
  }
  .t-notes {
    grid-column: span 2;
  }
  .courses {
    display: flex;
    flex-direction: column;
  }
  .courses a {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    gap: 8px;
    padding: 7px 0;
    border-top: 1px solid var(--line);
    color: var(--fg);
    font-size: 14px;
  }
  .courses a:first-child {
    border-top: 0;
  }
  .courses a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .code {
    font-size: 12px;
    color: var(--accent);
    align-self: center;
  }
  .n {
    color: var(--muted);
    font-size: 12px;
    align-self: center;
  }
  .t-posts {
    grid-column: span 2;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  li:first-child {
    border-top: 0;
  }
  li a {
    color: var(--fg);
  }
  time {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .t-small {
    grid-column: span 1;
  }
  @media (max-width: 820px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .t-proj,
    .t-stats,
    .t-about,
    .t-notes,
    .t-posts {
      grid-column: span 2;
    }
    .t-proj {
      grid-row: span 1;
    }
  }
</style>
