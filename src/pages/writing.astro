---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { byCategory, getPosts } from "../utils/posts";

const posts = await getPosts(byCategory("analysis", "essay", "esp"));
const filters = [
  { key: "all", label: "全部" },
  { key: "analysis", label: "分析" },
  { key: "essay", label: "杂文" },
  { key: "esp", label: "a bitter lesson(s) in ESP" },
];
---

<Base title="随笔">
  <div class="wrap">
    <header class="page-head">
      <h1>随笔</h1>
      <p>游戏、作品的分析，以及想到什么写什么的杂文。</p>
    </header>

    <div class="filters" role="tablist">
      {
        filters.map((f, i) => (
          <button type="button" class:list={["chip", { on: i === 0 }]} data-filter={f.key}>
            {f.label}
          </button>
        ))
      }
    </div>

    <p class="sub-link">
      <a href="/writing/esp/">a bitter lesson(s) in ESP 的标签索引 →</a>
    </p>

    <div class="list">
      <PostList posts={posts} empty="还没有随笔。" />
    </div>
  </div>
</Base>


<style>
  .filters {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
  }
  .sub-link {
    margin: -6px 0 18px;
    font-size: 14px;
  }
  .filters button {
    background: transparent;
    cursor: pointer;
    padding: 6px 12px;
  }
  .filters button.on {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
</style>
