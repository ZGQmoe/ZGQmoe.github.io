---
import { CATEGORIES } from "../config";
import { formatDate, readingTime, type Post } from "../utils/posts";

interface Props {
  posts: Post[];
  showCategory?: boolean;
  empty?: string;
}
const { posts, showCategory = true, empty = "还没有内容。" } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="post-list">
      {posts.map((p) => (
        <li data-category={p.data.category} data-tags={p.data.tags.join("|")}>
          <time class="mono" datetime={p.data.date.toISOString()}>
            {formatDate(p.data.date)}
          </time>
          <div class="body">
            <a class="title" href={`/posts/${p.id}/`}>
              {p.data.title}
              {p.data.draft && <span class="draft">草稿</span>}
            </a>
            {p.data.description && <p class="desc">{p.data.description}</p>}
            <span class="rt mono">约 {readingTime(p.body)} 分钟</span>
          </div>
          {showCategory && <span class="cat mono">{CATEGORIES[p.data.category].label}</span>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }
  li[hidden] {
    display: none;
  }
  li:last-child {
    border-bottom: 1px solid var(--line);
  }
  time {
    font-size: 13px;
    color: var(--muted);
  }
  .title {
    color: var(--fg);
    font-weight: 500;
  }
  .title:hover {
    color: var(--accent);
  }
  .desc {
    margin: 2px 0 0;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
  .rt {
    display: inline-block;
    margin-top: 4px;
    font-size: 12px;
    color: var(--muted);
  }
  .cat {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .draft {
    margin-left: 8px;
    font-size: 12px;
    color: #c2410c;
  }
  @media (max-width: 560px) {
    li {
      grid-template-columns: 1fr auto;
      gap: 2px 12px;
    }
    time {
      grid-column: 1 / -1;
      order: -1;
    }
  }
</style>
