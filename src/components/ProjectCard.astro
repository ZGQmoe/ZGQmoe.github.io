---
import Icon from "./Icon.astro";
import type { Project } from "../data/projects";

interface Props extends Project {
  big?: boolean;
}
const { name, description, tags, status, live, repo, kind, big = false } = Astro.props;
const href = live || repo || "#";
const statusLabel: Record<string, string> = { active: "维护中", paused: "暂停", archived: "已归档" };
---

<div class:list={["card spot reveal", { big }]}>
  <div class="top">
    {kind && <span class="kind mono">{kind}</span>}
    <span class:list={["status", status]}>{statusLabel[status]}</span>
    {
      repo && (
        <a class="repo" href={repo} aria-label={`${name} 源码`} title="源码">
          <Icon name="github" size={15} />
        </a>
      )
    }
  </div>
  <a class="main" href={href}>
    <span class="name mono">{name}</span>
    <span class="go"><Icon name="arrow" size={16} /></span>
  </a>
  <p>{description}</p>
  <div class="tags">{tags.map((t) => <span class="chip">{t}</span>)}</div>
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: 18px 18px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--fg);
    transition: transform 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
  }
  .top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .kind {
    color: var(--muted);
  }
  .status {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .status:not(.active) {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .repo {
    margin-left: auto;
    color: var(--muted);
    line-height: 0;
    position: relative;
    z-index: 2;
  }
  .repo:hover {
    color: var(--accent);
  }
  .main {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    color: var(--fg);
  }
  /* 整张卡片都可点（源码图标除外） */
  .main::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .main:hover {
    text-decoration: none;
  }
  .name {
    font-weight: 600;
    font-size: 17px;
  }
  .big .name {
    font-size: 22px;
  }
  .go {
    color: var(--muted);
    line-height: 0;
    transition: transform 0.2s;
  }
  .card:hover .go {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  p {
    margin: 6px 0 12px;
    font-size: 14px;
    color: var(--muted);
    line-height: 1.65;
    flex: 1;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
