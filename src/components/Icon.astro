---
// 简单的线条图标。新增平台时在这里加一个 case。
interface Props {
  name: string;
  size?: number;
}
const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === "github" && (
      <path
        fill="currentColor"
        stroke="none"
        d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
      />
    )
  }
  {
    name === "rss" && (
      <>
        <path d="M5 11a8 8 0 0 1 8 8" />
        <path d="M5 4a15 15 0 0 1 15 15" />
        <circle cx="6" cy="18" r="1.4" fill="currentColor" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
      </>
    )
  }
  {
    name === "bilibili" && (
      <>
        <rect x="3" y="6.5" width="18" height="13" rx="3" />
        <path d="m8 3.5 2.5 3M16 3.5l-2.5 3M9 12v2M15 12v2" />
      </>
    )
  }
  {
    name === "zhihu" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M8 8h8M12 8v8M8.5 16h7" />
      </>
    )
  }
  {
    name === "link" && (
      <>
        <path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1" />
        <path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1" />
      </>
    )
  }
  {
    name === "sun" && (
      <>
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </>
    )
  }
  {
    name === "moon" && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
  {
    name === "arrow" && <path d="M7 17 17 7M9 7h8v8" />
  }
</svg>
