---
interface Props {
  courses: { slug: string; code: string; title: string; count: number }[];
}
const { courses } = Astro.props;
---

<div class="cc">
  {
    courses.map((c) => (
      <a class="c spot reveal" href={`/notes/${c.slug}/`}>
        <span class="code mono">{c.code}</span>
        <span class="t">{c.title}</span>
        <span class="n mono">{c.count}</span>
      </a>
    ))
  }
</div>

<style>
  .cc {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
  }
  .c {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 8px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--fg);
    transition: transform 0.2s;
  }
  .c:hover {
    text-decoration: none;
    transform: translateY(-2px);
  }
  .code {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }
  .t {
    grid-column: 1;
    font-size: 14px;
  }
  .n {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    font-size: 20px;
    font-weight: 600;
    color: var(--muted);
  }
</style>
