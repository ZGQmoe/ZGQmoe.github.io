---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "katex/dist/katex.min.css";
import { NAV, SITE, SOCIALS } from "../config";
import Icon from "../components/Icon.astro";
import Ocean from "../components/Ocean.astro";

interface Props {
  title?: string;
  description?: string;
  /** full：首页，鲨鱼全亮；dim：内容页，鲨鱼调暗，正文放在玻璃面板上 */
  ocean?: "full" | "dim";
  /** 文章页显示阅读进度条 */
  progress?: boolean;
}
const { title, description = SITE.description, ocean = "dim", progress = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.author}`;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN" data-ocean={ocean}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // 在首帧之前套上主题，避免闪烁；页面切换后再套一次（新页面的 <html> 不带 data-theme）。
      (() => {
        const apply = (doc) => {
          try {
            const t = localStorage.getItem("theme");
            if (t === "light" || t === "dark") doc.documentElement.dataset.theme = t;
          } catch {}
        };
        apply(document);
        document.addEventListener("astro:before-swap", (e) => apply(e.newDocument));
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <Ocean />
    {progress && <div class="progress" aria-hidden="true"></div>}

    <header class:list={["site-head", { overlay: ocean === "full" }]}>
      <div class="head-inner">
        <a class="brand mono" href="/"><span class="prompt">~/</span>tomochan<span class="caret">_</span></a>
        <nav>
          {
            NAV.map((n) => (
              <a href={n.href} class:list={{ active: isActive(n.href) }}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <button class="theme-btn" type="button" aria-label="切换深浅色" title="切换深浅色">
          <span class="i-sun"><Icon name="sun" size={16} /></span>
          <span class="i-moon"><Icon name="moon" size={16} /></span>
        </button>
      </div>
    </header>

    <main transition:animate="fade">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <div class="foot-left mono">
          <span>© {SITE.startYear === year ? year : `${SITE.startYear}–${year}`} {SITE.author}</span>
          <span class="muted" data-since={SITE.since}>本站已运行 <b>…</b> 天</span>
        </div>
        <span class="foot-links">
          {
            SOCIALS.map((s) => (
              <a href={s.href} aria-label={s.label} title={s.label}>
                <Icon name={s.icon} size={16} />
              </a>
            ))
          }
        </span>
      </div>
    </footer>

    <button class="to-top" type="button" aria-label="回到顶部" title="回到顶部">↑</button>

    <script>
      import "../scripts/fx";
    </script>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .site-head.overlay {
    position: absolute;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .head-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 20px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .brand {
    font-weight: 600;
    color: var(--fg);
    white-space: nowrap;
  }
  .brand .prompt {
    color: var(--accent);
  }
  .caret {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .brand:hover {
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scrollbar-width: none;
    flex: 1;
    font-size: 15px;
  }
  nav::-webkit-scrollbar {
    display: none;
  }
  nav a {
    position: relative;
    color: var(--muted);
    white-space: nowrap;
    padding: 4px 0;
  }
  nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--grad-1), var(--grad-3));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  nav a:hover {
    color: var(--fg);
    text-decoration: none;
  }
  nav a:hover::after,
  nav a.active::after {
    transform: scaleX(1);
  }
  nav a.active {
    color: var(--fg);
  }
  .theme-btn {
    flex: none;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    color: var(--muted);
    cursor: pointer;
    transition: transform 0.3s ease;
  }
  .theme-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: rotate(20deg);
  }
  .i-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .i-moon {
      display: block;
    }
  }
  :global(:root[data-theme="dark"]) .i-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .i-moon {
    display: block;
  }
  .i-sun,
  .i-moon {
    line-height: 0;
  }
  main {
    min-height: calc(100vh - 56px - 80px);
  }
  .site-foot {
    margin-top: 72px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 64px;
    gap: 12px;
  }
  .foot-left {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .foot-left b {
    color: var(--accent);
    font-weight: 600;
  }
  .foot-links {
    display: flex;
    gap: 14px;
  }
  .foot-links a {
    color: var(--muted);
    line-height: 0;
  }
  .foot-links a:hover {
    color: var(--accent);
  }
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    z-index: 20;
    transform-origin: left;
    transform: scaleX(var(--read, 0));
    background: linear-gradient(90deg, var(--grad-1), var(--grad-2), var(--grad-3));
  }
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 15;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--fg);
    font: 600 16px/1 var(--mono);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 0.25s,
      transform 0.25s,
      border-color 0.2s;
  }
  .to-top.show {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .to-top:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .brand {
      display: none;
    }
    .head-inner {
      gap: 12px;
    }
    nav {
      gap: 14px;
    }
  }
</style>
